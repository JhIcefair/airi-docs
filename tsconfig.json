{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitepress/client",
      "vue"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "scripts/**/*.ts",
    "packages/vitepress-theme/src/shims.d.ts",
    "vite-env.d.ts",
    "uno.config.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/*/dist"
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}
