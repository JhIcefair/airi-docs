{
  "name": "@proj-airi/vitepress-theme",
  "type": "module",
  "version": "0.1.0",
  "description": "VitePress theme of the Project AIRI documentation site",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/airi-docs/tree/main/packages/vitepress-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/airi-docs.git",
    "directory": "packages/vitepress-theme"
  },
  "keywords": [
    "vitepress",
    "vitepress-theme",
    "airi"
  ],
  "sideEffects": [
    "*.css",
    "./src/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./components/*": "./src/components/*",
    "./composables/*": "./src/composables/*.ts",
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./unocss": {
      "types": "./dist/unocss.d.mts",
      "default": "./dist/unocss.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp && pnpm publish --access public"
  },
  "peerDependencies": {
    "unocss": ">=66.0.0",
    "vite": ">=7.0.0",
    "vitepress": "^2.0.0-alpha.17",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "catalog:",
    "@fontsource-variable/dm-sans": "catalog:",
    "@fontsource-variable/quicksand": "catalog:",
    "@fontsource/dm-mono": "catalog:",
    "@fontsource/dm-serif-display": "catalog:",
    "@iconify/vue": "catalog:",
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@mdit/plugin-footnote": "catalog:",
    "@mdit/plugin-tasklist": "catalog:",
    "@moeru/std": "catalog:",
    "@nolebase/vitepress-plugin-git-changelog": "catalog:",
    "@proj-airi/unocss-preset-chromatic": "catalog:",
    "@radix-ui/colors": "catalog:",
    "@unocss/reset": "catalog:",
    "@vueuse/core": "catalog:",
    "colorjs.io": "catalog:",
    "date-fns": "catalog:",
    "gray-matter": "catalog:",
    "mark.js": "catalog:",
    "markdown-it-anchor": "catalog:",
    "minisearch": "catalog:",
    "motion-v": "catalog:",
    "pathe": "catalog:",
    "reka-ui": "catalog:",
    "tinyglobby": "catalog:",
    "unplugin-yaml": "catalog:",
    "vue-i18n": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue/tsconfig": "catalog:",
    "bumpp": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
